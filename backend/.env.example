# --- Database (SQLite by default; PostgreSQL works too) ---
# DATABASE_URL=sqlite:///./data/speclens.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/speclens

# --- AI provider (any OpenAI-compatible API). Leave AI_API_KEY empty for demo mode. ---
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
AI_BATCH_SIZE=12

# --- App ---
MAX_UPLOAD_MB=25
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
